{
  "name": "eventlink-root",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "pnpm clean:node_modules && pnpm clean:dist",
    "clean:node_modules": "find . -name 'node_modules' -print -type d -prune -exec rm -rf '{}' + ",
    "clean:dist": "find . -name 'dist' -print -type d -prune -exec rm -rf '{}' + ",
    "lint": "pnpm nx run-many --target=lint",
    "types": "pnpm nx run-many --target=types",
    "format": "pnpm prettier . --write && pnpm eslint . --fix",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.9.1",
    "@gxxc/nx-anchor": "^0.0.8",
    "@nx/devkit": "21.5.3",
    "@nx/eslint": "21.5.3",
    "@nx/eslint-plugin": "21.5.3",
    "@nx/jest": "21.5.3",
    "@nx/js": "21.5.3",
    "@nx/plugin": "21.5.3",
    "@nx/vite": "21.5.3",
    "@nx/web": "21.5.3",
    "@swc-node/register": "~1.9.2",
    "@swc/cli": "0.6.0",
    "@swc/core": "~1.5.29",
    "@swc/helpers": "~0.5.12",
    "@types/jest": "30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/utils": "8.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.5",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "jest-environment-node": "^29.7.0",
    "jest-util": "30.0.5",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lint-staged": "^15.2.9",
    "nx": "21.5.3",
    "prettier": "^2.8.8",
    "prettier-plugin-rust": "^0.1.9",
    "swc-loader": "0.1.15",
    "ts-jest": "29.4.1",
